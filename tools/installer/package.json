{
    "name": "guild-manager-installer",
    "version": "1.0.0",
    "description": "Standalone installer for Guild Manager",
    "main": "src/index.js",
    "bin": "src/index.js",
    "scripts": {
        "start": "node src/index.js",
        "build": "pkg . --output dist/installer.exe --targets node18-win-x64"
    },
    "dependencies": {
        "axios": "^1.6.0",
        "cli-progress": "^3.12.0",
        "js-yaml": "^4.1.0",
        "chalk": "^4.1.2"
    },
    "devDependencies": {
        "pkg": "^5.8.1"
    },
    "pkg": {
        "assets": [
            "node_modules/chalk/**/*",
            "node_modules/cli-progress/**/*",
            "node_modules/js-yaml/**/*"
        ]
    }
}